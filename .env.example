# Host the booster announces to the client. This is the one host baked into the
# patched client (see tools/build_apk.py); everything else is announced at runtime.
BOOSTER_API_HOST=booster.example.com

# Where the booster binds (nginx terminates TLS in front and proxies to this).
BOOSTER_BIND=127.0.0.1
BOOSTER_PORT=18084

# Asset CDN announced to the client (get_all_constants). Point it at wherever you
# serve the files produced by tools/fetch_resources.py.
# BOOSTER_ASSET_URL=https://booster.example.com/cdn

# Account portal / support webview hosts announced to the client.
# BOOSTER_NA_URL=https://booster.example.com/baas
# BOOSTER_WEBVIEW_URL=https://booster.example.com/support

# Realtime (Izumo) matchmaking server, announced to the client. Plain TCP/UDP on a
# port nginx `stream` forwards to tools/izumo_listen.py.
BOOSTER_IZUMO_HOST=realtime.example.com
BOOSTER_IZUMO_PORT=11401

# Seconds during which an account stays bound to the device that last used it; another
# device signing in to the same account inside that window is refused.
# OPENTOUR_ACCOUNT_BUSY_S=60

# Optional secret used to sign the support-webview identity cookie. Leave empty to
# disable webview identity cookies.
INTERNAL_API_TOKEN=

# Country/language the emulated Nintendo Account reports.
# BOOSTER_NA_COUNTRY=US
# BOOSTER_NA_LANGUAGE=en-US

# Path to the extracted keys file. Defaults to ./keys/keys.json.
# OPENTOUR_KEYS=/abs/path/to/keys.json
